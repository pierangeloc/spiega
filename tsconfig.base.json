{
  // The compiler options every package shares. Strict from the first commit,
  // and strict means strict: no `any`, no `@ts-ignore`, no flag loosened to
  // buy a green check. That rule is older than the migration — it is why the
  // modules that opted in early are worth having opted in.
  //
  // `allowJs` is off, and said so rather than left to the default, because it
  // was on for the whole of the migration: it let a ported module sit beside
  // the JavaScript it had not replaced yet. The migration is finished (#160) —
  // the source trees are TypeScript, every module in them is checked, and
  // nothing may turn it back on to let a `.js` file in without being checked.
  "compilerOptions": {
    "allowJs": false,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "types": []
  }
}
