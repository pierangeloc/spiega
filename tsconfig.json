{
  // The root's own sources: the TypeScript modules ported so far, listed one
  // by one. The render package is finished (#141–#145); what is left is the
  // JavaScript outside it, which opts in with `// @ts-check` and a line here,
  // because `checkJs` stays off for the files that have not been ported.
  //
  // Shared options live in tsconfig.base.json, which every package extends.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "vitest.config.ts",
    "eslint.config.js",
    "src/index.ts",
    "src/spec.ts",
    "src/board/state.ts",
    "src/board/settle.ts",
    "src/board/camera.ts",
    "src/board/script.ts",
    "src/board/map.ts",
    "src/board/tape.ts",
    "src/board/snapshot.ts",
    "src/board/export.ts",
    "src/board/open.ts",
    "src/render/render.ts",
    "src/render/audit.ts",
    "src/render/layout.ts",
    "src/render/floating.ts",
    "src/render/theme.ts",
    "src/render/math.ts",
    "src/render/geom.ts",
    "src/render/ink.ts",
    "src/render/glyphs.ts",
    "src/render/edges.ts",
    "src/render/callout.ts"
  ]
}
