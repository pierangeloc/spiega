{
  // The root's own sources: all of src/, which is TypeScript and nothing else
  // since #160. Every module is checked by being there; none opts in.
  //
  // Not here: test/*.mjs and tools/*.js, which run as JavaScript (whether the
  // suites follow is #170), and eslint.config.js, for the same reason — ESLint
  // reads a TypeScript config only behind an unstable flag. With allowJs off a
  // `.js` listed here is skipped without a word, so it is not listed at all;
  // its `// @ts-check` is for an editor now, not for this.
  //
  // Shared options live in tsconfig.base.json, which every package extends.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "vitest.config.ts",
    "src/**/*.ts"
  ]
}
