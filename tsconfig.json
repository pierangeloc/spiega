{
  // The JavaScript that has not been ported yet. Types are opt-in here: the
  // modules below say `// @ts-check` and are listed one by one, because
  // turning `checkJs` on would also check the render modules they import,
  // which together still carry ~234 strict errors. Annotating those is the
  // render port's job (#141–#145), not this file's.
  //
  // Shared options live in tsconfig.base.json, which every package extends.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "vitest.config.ts",
    "eslint.config.js",
    "src/index.ts",
    "src/spec.ts",
    "src/board/state.ts",
    "src/board/settle.js",
    "src/board/camera.ts",
    "src/board/script.ts",
    "src/board/map.ts",
    "src/board/tape.ts",
    "src/render/render.js",
    "src/render/layout.js",
    "src/render/floating.js",
    "src/render/theme.ts",
    "src/render/math.ts",
    "src/render/geom.ts"
  ]
}
