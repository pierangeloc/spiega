{
  "name": "spiega",
  "version": "0.2.0",
  "description": "A hand-drawn board an AI agent draws on while it explains software architecture.",
  "type": "module",
  "bin": {
    "spiega": "bin/spiega"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "integrations",
    "examples",
    "test",
    "docs/logo/*.svg",
    "docs/*.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "test": "node test/smoke.mjs",
    "prepublishOnly": "npm test && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "serve": "node src/cli.js serve --open",
    "mcp": "node src/mcp/server.js",
    "shapes": "node tools/shapes.js"
  },
  "keywords": [
    "diagram",
    "architecture",
    "whiteboard",
    "agent",
    "mcp",
    "claude",
    "cursor",
    "svg",
    "hand-drawn"
  ],
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierangeloc/spiega.git"
  },
  "bugs": {
    "url": "https://github.com/pierangeloc/spiega/issues"
  },
  "homepage": "https://github.com/pierangeloc/spiega#readme",
  "author": "Pierangelo Cecchetto - TulipLogic",
  "publishConfig": {
    "access": "public"
  }
}
