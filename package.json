{
  "name": "spiega",
  "version": "0.5.0",
  "private": true,
  "description": "A hand-drawn board an AI agent draws on while it explains software architecture.",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "bin": {
    "spiega": "bin/spiega"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "vendor",
    "skills",
    "integrations",
    "examples",
    "test",
    "!test/*.spec.mjs",
    "docs/logo/*.svg",
    "docs/*.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "scripts": {
    "build": "node tools/build.js",
    "test": "pnpm run build && vitest run",
    "typecheck": "tsc --noEmit && pnpm -r --if-present run typecheck",
    "pack": "pnpm run build && npm pack ./dist --pack-destination .",
    "release": "pnpm test && pnpm run typecheck && npm publish ./dist",
    "serve": "pnpm run build && node dist/src/cli.js serve --open",
    "mcp": "pnpm run build && node dist/src/mcp/server.js",
    "shapes": "node tools/shapes.js",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "diagram",
    "architecture",
    "whiteboard",
    "agent",
    "mcp",
    "claude",
    "cursor",
    "pi",
    "svg",
    "hand-drawn"
  ],
  "devDependencies": {
    "tsdown": "0.23.7",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierangeloc/spiega.git"
  },
  "bugs": {
    "url": "https://github.com/pierangeloc/spiega/issues"
  },
  "homepage": "https://github.com/pierangeloc/spiega#readme",
  "author": "Pierangelo Cecchetto - TulipLogic",
  "publishConfig": {
    "access": "public"
  }
}
